# ─────────────────────────────────────────────────────────────
# Deep Search in Media Library — environment configuration
# Copy to `.env` and adjust. All values have sane defaults.
# ─────────────────────────────────────────────────────────────

# --- Gemma 4 (via Ollama) ---
DEEPSEARCH_OLLAMA_HOST=http://localhost:11434
# Multimodal vision+audio generation / reranking / intent model
DEEPSEARCH_GEMMA_MODEL=gemma4:e4b
# Text embedding model used for the unified retrieval space (describe-then-embed)
DEEPSEARCH_EMBED_MODEL=nomic-embed-text
# Embedding strategy: describe_then_embed (default, robust) | native (experimental)
DEEPSEARCH_EMBED_STRATEGY=describe_then_embed

# --- Qdrant (local on-disk mode by default; no server needed) ---
# Leave URL empty to use embedded local storage at DEEPSEARCH_QDRANT_PATH.
DEEPSEARCH_QDRANT_URL=
DEEPSEARCH_QDRANT_PATH=./qdrant_storage
DEEPSEARCH_COLLECTION=media_library

# --- Ingestion ---
DEEPSEARCH_AUDIO_CHUNK_SECONDS=30
DEEPSEARCH_AUDIO_OVERLAP_SECONDS=5
DEEPSEARCH_SCENE_THRESHOLD=27.0
DEEPSEARCH_MAX_KEYFRAMES=40

# --- Retrieval ---
DEEPSEARCH_TOP_K=10
# Rerank uses a slow LLM call (10-100s on local e4b). Off by default for speed;
# set true to trade latency for deep-reasoning reranking.
DEEPSEARCH_RERANK=false

# --- Runtime ---
# Set true to bypass Ollama and use deterministic stub models (CI / offline dev).
DEEPSEARCH_USE_STUB=false
DEEPSEARCH_LOG_LEVEL=INFO
